: translate(-50%, -50%);\n  text-align: justify; }\n\n.community-edition i {\n  font-size: 60px;\n  color: #2b6dca;\n  margin-bottom: 20px; }\n\n.community-edition:hover {\n  background-color: #aee8f9;\n  color: #515151; }\n\n.slideanim {\n  padding-top: 40px;\n  color: #ffffff; }\n\n.para3 {\n  text-align: justify;\n  padding: 30px; }\n"

