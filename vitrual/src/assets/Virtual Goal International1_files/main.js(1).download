ht */\n  min-height: 270px;\n  /* Create the parallax scrolling effect */\n  background-attachment: fixed;\n  background-position: center;\n  background-repeat: no-repeat;\n  background-size: cover;\n  text-align: center;\n  color: #ffffff; }\n\n.overl {\n  position: absolute;\n  z-index: 2;\n  width: 101%;\n  height: 270px;\n  opacity: 0.7;\n  background-color: #094464; }\n\n.head_title {\n  margin-bottom: 1px; }\n\n.head_title p {\n  max-width: 100%;\n  margin: 10px auto;\n  padding-bottom: 20px; }\n\np {\n  line-height: 0rem;\n  font-size: 0rem; }\n"

