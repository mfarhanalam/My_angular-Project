/***/ (function(module, exports) {

module.exports = "<!--Home page style-->\n<header id=\"home\" class=\"home\" style=\"margin-top: 107px\">\n    <div class=\"overlay-fluid-block \">\n        <div class=\"container text-center\">\n            <div class=\"row\">\n                <div class=\"home-wrapper\">\n                    <div class=\"col-md-10 col-md-offset-1\">\n                        <div class=\"home-content\">\n                            <h2 style=\"color: #fff;font-weight: bold\">Nous vous offrons le futur dans le\n                                <br> Digital présentement ici chez\n                            </h2>\n                            <br>\n                            <h1 style=\"color: #be060c\">\n                                VIRTUAL GOAL INTL\n                            </h1>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</header>\n<section id=\"features\" class=\"features sections\">\n    <!-- <div class=\" col-md-12 head_title text-center\"></div> -->\n    <div class=\"col-md-1\"></div>\n    <div class=\"col-md-10 text-center \">\n        <br>\n        <span style=\"color: #ca080e;font-size: 30px;\">Bienvenue chez Virtual Goal</span>\n        <br>\n        <h5>VIRTUAL GOAL INTL EST UNE FINTECH</h5>\n        <hr class=\"lin1\">\n        <p>Crée en 2022, ayant en son sein des dirigeants de plus de 10 ans d'expérience dans le domaine du digital, des systèmes\n            de paiement et dans la monétique. Nous avons comme axes, le développement de logiciels, d'applications mobiles\n            et du contenu mobile. Ayant un grand partenaire au nom de BizMobia en Inde. L'Inde qui est l'un des pays des\n            grandes sociétés de logiciels au monde. Nous sommes partenaires de 3 opérateurs de téléphonie mobile dans le\n            pays.\n        </p>\n    </div>\n    <div class=\"col-md-1\"></div>\n    <div class=\"container animate slideInRight\">\n        <div class=\"row\">\n            <div class=\"main_features_content2\" style=\"margin-top: 35px\">\n                <div class=\"col-sm-6\">\n                    <div class=\"single_features_left text-center\">\n                        <img src=\"assets/image/vgi/home1.jpg\" alt=\"\" style=\"margin-top: 62px;height: auto;\" />\n                    </div>\n                </div>\n                <div class=\"col-sm-6 \">\n                    <div class=\"single_features_right \">\n                        <h4 style=\"font-size: 23px\">DITES NOUS VOS REVES, NOUS LES REALISONS</h4>\n                        <hr class=\"lin2\">\n                        <p style=\"line-height: 32px;text-align: justify;font-size: 15px;\">\n                            Virtual Goal International est une société réputée FinTech International basée à Kinshasa, en RD Congo. Nous fournissons\n                            des services numériques dans chaque domaine de la vie. Nous fournissons l'infrastructure numérique\n                            complète pour les universités, les écoles, les hôpitaux, les restaurants, etc.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n<section id=\"business\" class=\"portfolio sections desktop\">\n    <div class=\"container\">\n        <div class=\"head_title text-center\">\n            <p style=\"font-size: 19px;line-height: 22px;font-weight: bold;color: #ca080e\">Veuillez faire glisser la souris sur les images ci-dessous pour voir les détails</p>\n        </div>\n        <div class=\"row\">\n            <div class=\"portfolio-wrapper text-center\">\n                <div class=\"col-md-4 col-sm-6 col-xs-12\">\n                    <!-- <div class=\"community-edition\"> -->\n                    <div class=\"containerz\">\n                        <img src=\"assets/image/vgi/vgi3.jpg\" alt=\"Avatar\" class=\"imagez\">\n                        <div class=\"overlayz\">\n                            <div class=\"textz\">Qui sommes-nous ?</div>\n                            <div class=\"para\">\n\n                                Un groupe d'experts et de professionnels talentueux travaillant pour faciliter la vie de nos populations\n                            </div>\n                        </div>\n                    </div>\n                    <!-- </div> -->\n                </div>\n\n                <div class=\"col-md-4 col-sm-6 col-xs-12 smallhide\">\n                    <div class=\"containerz\">\n                        <img src=\"assets/image/vgi/vgi6.jpg\" alt=\"Avatar\" class=\"imagez\">\n                        <div class=\"overlayz\">\n                            <div class=\"textz\">Pourquoi nous choisir?</div>\n                            <div class=\"para\">\n                                Certains diront peut-être un peu trop, et nous apportons enthousiasme et engagement à tous les projets sur lesquels nous\n                                travaillons.\n                            </div>\n                        </div>\n                    </div>\n                </div>\n\n                <div class=\"col-md-4 col-sm-6 col-xs-12 flowrightt\">\n                    <div class=\"containerz\">\n                        <img src=\"assets/image/vgi/vgi4.jpg\" alt=\"Avatar\" class=\"imagez\">\n                        <div class=\"overlayz\">\n                            <div class=\"textz\">Notre Mission</div>\n                            <div class=\"para\">\n                                Faciliter la vie des gens et pour nos clients, améliorer leur rendement par des solutions adaptées, de haute qualité pour\n                                les besoins spécifiques du marché.\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"row\">\n            <div class=\"portfolio-wrapper text-center\">\n              <div class=\"col-md-4 col-sm-6 col-xs-12\">\n                <!-- <div class=\"community-edition\"> -->\n                <div class=\"containerz\">\n                  <img src=\"assets/image/vgi/vgi5.jpg\" alt=\"Avatar\" class=\"imagez\">\n                  <div class=\"overlayz\">\n                    <div class=\"textz\">Notre Vision</div>\n                    <div class=\"para\">\n                      Innovatrice dans le secteur du Digital en RDC, dans la sous- région et même en Afrique.\n                    </div>\n                  </div>\n                </div>\n                <!-- </div> -->\n              </div>\n      \n              <div class=\"col-md-4 col-sm-6 col-xs-12 smallhide\">\n                <div class=\"containerz\">\n                  <img src=\"assets/image/vgi/ma.jpg\" alt=\"Avatar\" class=\"imagez\">\n                  <div class=\"overlayz\">\n                    <div class=\"textz\">TBD</div>\n                    <div class=\"para\">\n                      TBD\n                    </div>\n                  </div>\n                </div>\n              </div>\n      \n              <div class=\"col-md-4 col-sm-6 col-xs-12 flowrightt\">\n                <div class=\"containerz\">\n                  <img src=\"assets/image/vgi/sd.jpg\" alt=\"Avatar\" class=\"imagez\">\n                  <div class=\"overlayz\">\n                    <div class=\"textz\">TBD</div>\n                    <div class=\"para\">\n                      TBD\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n    </div>\n</section>"

