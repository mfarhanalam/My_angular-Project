module.exports = "<div *ngIf=\"myCheck2\" class=\"overlay\"></div>\n\n<div style=\"position: relative;margin-top: 90px\">\n  <div class=\"parallax1\">\n    <div class=\"overl\">\n      <div class=\"row slideanim\">\n        <br>\n        <h1>Careers</h1>\n      </div> \n    </div>\n  </div>\n  <!-- <br> -->\n  <div class=\"row parallax2\">\n    <div class=\"col-md-2\"></div>\n    <div class=\"col-md-8\">\n      <br>\n      <br>\n      <br>\n      <div  style=\"text-align:center ;color:#fff;\"><strong>Current Opening</strong></div>\n      <div style=\"border: 25px solid #e5e7ecc5;margin-bottom: 50px;overflow-x:auto\">\n        <ul class=\"nav nav-tabs\">\n          <li class=\"active\" *ngFor=\"let webApp1 of firstjobList\">\n            <a data-toggle=\"tab\" href=\"#{{webApp1.id}}\"><strong>{{webApp1.title}}</strong></a>\n          </li>\n          <li *ngFor=\"let webApp of jobList\">\n            <a data-toggle=\"tab\" href=\"#{{webApp.id}}\"><strong>|&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{{webApp.title}}</strong></a>\n          </li>\n        </ul>\n        <div class=\"tab-content bgc pad\" >\n\n          <div id=\"{{webApp1.id}}\" class=\"tab-pane fade in active\" *ngFor=\"let webApp1 of firstjobList\">\n            <h4>{{firstjob.title}}</h4>\n            <table align=\"center\" border=\"1\" style=\"width: 99%;background-color: #fff\" class=\"border\" class=\"table-responsive\">\n              <tr>\n                <th>\n                  Designation\n                </th>\n                <th>\n                  Required Skills\n                </th>\n                <th style=\"white-space: nowrap\">\n                  Number of Openings\n                </th>\n                <th style=\"white-space: nowrap\">\n                  Experience Required\n                </th>\n              </tr>\n              <tr>\n                <td>\n                  {{webApp1.description}}\n                </td>\n                <td align=\"left\" style=\"text-align: justify\">\n                  {{webApp1.skills}}\n                </td>\n                <td align=\"center\">\n                  {{webApp1.noofpositions}}\n                </td>\n                <td align=\"center\">\n                  {{webApp1.experience}}\n                </td>\n              </tr>\n              <tr>\n                <td colspan=\"4\" align=\"center\">\n                  <button class=\"btn btn-info apply\" (click)=\"m1(webApp1)\">Apply Now</button>\n                </td>\n              </tr>\n            </table>\n          </div>\n          <div id=\"{{webApp.id}}\" class=\"tab-pane fade\" *ngFor=\"let webApp of jobList\">\n            <h4>{{webApp.title}}</h4>\n            <table align=\"center\" border=\"1\" style=\"width: 99%;background-color: #fff\" class=\"border\">\n              <tr>\n                <th>\n                  Designation\n                </th>\n                <th>\n                  Required Skills\n                </th>\n                <th style=\"white-space: nowrap\">\n                  Number of Openings\n                </th>\n                <th style=\"white-space: nowrap\">\n                  Experience Required\n                </th>\n              </tr>\n              <tr>\n                <td>\n                  {{webApp.description}}\n                </td>\n                <td align=\"left\" style=\"text-align: justify\">\n                  {{webApp.skills}}\n                </td>\n                <td align=\"center\">\n                  {{webApp.noofpositions}}\n                </td>\n                <td align=\"center\">\n                  {{webApp.experience}}\n                </td>\n              </tr>\n              <tr>\n                <td colspan=\"4\" align=\"center\">\n                  <button class=\"btn btn-info apply\" (click)=\"m1(webApp)\">Apply Now</button>\n                </td>\n              </tr>\n            </table>\n          </div>\n        </div>\n      </div>\n    </div>\n    <div class=\"col-md-2\"></div>\n  </div>\n  <br>\n\n  <div class=\"light \" *ngIf=\"myCheck\">\n    <div class=\"title\">\n      <span style=\"float:left;\">Fillup Details</span>\n      <span style=\"float:right;cursor:default\" (click)=\"m2()\">&times;</span>\n    </div>\n    <div class=\"details\">\n      <form (ngSubmit)=\"postJob()\" #job=\"ngForm\" novalidate>\n        <table style=\"width: 100%;\">\n          <tr>\n            <td>\n              <div class=\"form-group\">\n                <input type=\"text\" class=\"form-control\" name=\"applicantname\" [(ngModel)]=\"postJobObj.applicantname\" #applicantname=\"ngModel\"\n                  placeholder=\"Please Enter Name\" required minlength=\"3\" />\n              </div>\n            </td>\n            <td>\n              <div class=\"form-group\">\n                <input type=\"text\" class=\"form-control\" name=\"applicantphoneno\" [(ngModel)]=\"postJobObj.applicantphoneno\" #applicantphoneno=\"ngModel\"\n                  placeholder=\"Plesae Enter Mobile Number\" required minlength=\"3\" />\n              </div>\n            </td>\n          </tr>\n          <tr>\n            <td>\n              <input type=\"text\" class=\"form-control\" name=\"applicantemail\" [(ngModel)]=\"postJobObj.applicantemail\" #applicantemail=\"ngModel\"\n                placeholder=\"Please Enter E-Mail ID\" required minlength=\"3\" />\n            </td>\n            <td>\n              <input type=\"text\" class=\"form-control\" name=\"address\" [(ngModel)]=\"postJobObj.address\" #address=\"ngModel\" placeholder=\"Please Enter Address\"\n                required minlength=\"3\" />\n            </td>\n          </tr>\n          <tr>\n            <td>\n              \n              <input type=\"radio\" value=\"Male\" id=\"gender1\" name=\"gender\" [(ngModel)]=\"postJobObj.gender\" #gender=\"ngModel\" \n                required>\n              <label for=\"gender1\">Male</label>\n              <input type=\"radio\" id=\"gender2\" value=\"Female\" name=\"gender\" [(ngModel)]=\"postJobObj.gender\" #gender=\"ngModel\"\n                required>\n              <label for=\"gender2\">Female</label>\n            </td>\n            <td>\n              <input type=\"text\" class=\"form-control\" name=\"higestqualification\" [(ngModel)]=\"postJobObj.higestqualification\" #higestqualification=\"ngModel\"\n                placeholder=\"Highest Educational Qualification\" required minlength=\"3\" />\n            </td>\n          </tr>\n          <tr>\n            <td>\n              <input type=\"text\" class=\"form-control\" name=\"expectedsalary\" [(ngModel)]=\"postJobObj.expectedsalary\" #expectedsalary=\"ngModel\"\n                placeholder=\"Expected Salary\" required minlength=\"3\" />\n            </td>\n            <td>\n              <input type=\"text\" class=\"form-control\" name=\"experience\" [(ngModel)]=\"postJobObj.experience\" #experience=\"ngModel\" placeholder=\"Experience\"\n              />\n            </td>\n          </tr>\n          <tr>\n            <td align=\"left\">\n              <table>\n                <tr>\n                  <td>\n                    Please Upload Your Resume\n                  </td>\n                </tr>\n                <tr>\n                  <td>\n                    <div class=\"form-group\">\n                      <input type=\"file\" id=\"avatar\" (change)=\"onFileChange($event)\" #fileInput/>\n                    </div>\n                  </td>\n                </tr>\n                <tr>\n                  <td>\n                    .Doc, .Docx or .PDF file only!\n                  </td>\n                </tr>\n              </table>\n            </td>\n            <td align=\"right\" style=\"vertical-align: bottom;\">\n              <table>\n                <tr>\n                  <td>\n                    <button type=\"submit\" class=\"btn btn-info apply\">Apply</button>\n                  </td>\n                  <td>\n                    <button class=\"btn btn-info apply\" (click)=\"m2()\">Cancel</button>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n        </table>\n      </form>\n      <!-- <button (click)=\"m2()\">Salim</button> -->\n    </div>\n  </div>"

