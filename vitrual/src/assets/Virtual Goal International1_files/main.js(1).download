module.exports = "<!-- TEST PARALLAX START HERE -->\n<div class=\"parallax2\" style=\"margin-top: 50px\">\n  <h2 class=\"hed\">BIZMOBIA A SOFTWARE COMPANY</h2>\n  <br>\n  <p class=\"para2\">\n    It has more than 5 years of experience in Software & Mobile Application Development & Mobile Content field. BizMobia, India's\n    one of the big known Software Company. BizMobia is associated with more than 20 mobile operators in 30 countries including\n    India, SEA and MEA. We have more than 1 billion successful downloads.\n  </p>\n</div>\n\n<!-- TEST PARALLAX END HERE -->\n\n\n\n\n<!-- Sections -->\n<section id=\"business\" class=\"portfolio sections\">\n    <div style=\"text-align: center\">PLEASE HOVER THE MOUSE ON THE BELOW GIVEN IMAGES TO VIEW DETAILS</div>\n    <br><br>\n  <div class=\"container\">\n\n    <div class=\"row\">\n      <div class=\"portfolio-wrapper text-center\">\n        <div class=\"col-md-4 col-sm-6 col-xs-12\">\n          <!-- <div class=\"community-edition\"> -->\n          <div class=\"containerz\">\n            <img src=\"assets/images/officenew.jpg\" alt=\"Avatar\" class=\"imagez\">\n            <div class=\"overlayz\">\n              <div class=\"textz\">WHO WE ARE?</div>\n              <div class=\"para\">\n                The expert group of talented professionals in BizMobia team works closely with the clients to build, run and leverage solutions\n                that help businesses.\n              </div>\n            </div>\n          </div>\n          <!-- </div> -->\n        </div>\n\n        <div class=\"col-md-4 col-sm-6 col-xs-12 smallhide\">\n          <div class=\"containerz\">\n            <img src=\"assets/images/ip3.jpg\" alt=\"Avatar\" class=\"imagez\">\n            <div class=\"overlayz\">\n              <div class=\"textz\">WHY CHOOSE US?</div>\n              <div class=\"para\">\n                We love what we do, some might say a bit too much, and we bring enthusiasm and commitment to every project we work on.\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"col-md-4 col-sm-6 col-xs-12 flowrightt\">\n          <div class=\"containerz\">\n            <img src=\"assets/images/mission.jpg\" alt=\"Avatar\" class=\"imagez\">\n            <div class=\"overlayz\">\n              <div class=\"textz\">OUR MISSION</div>\n              <div class=\"para\">\n                Our mission is to enhancing the business growth of our customers with creative Design and Development to deliver market-defining\n                high-quality solutions.\n              </div>\n            </div>\n          </div>\n        </div>\n\n\n\n\n      </div>\n    </div>\n\n  </div>\n  <!-- /container -->\n</section>\n\n\n<div class=\"parallax3\">\n  <div class=\"overl\">\n      <div class=\"row slideanim\">\n          <div class=\"col-sm-6 \">\n            <!-- <span class=\"fa fa-refresh logo-small\"></span> -->\n            <h4>\n              <li class=\"fa fa-mobile\"></li> &nbsp;&nbsp;100% Responsive</h4>\n              <p class=\"para3\">We will leverage our responsive design expertise and avail you engage your customers with fluid design, flexible images and overall simplicity. Reach your customers on multiple touch points \n                  to increment your conversions and grow your business today, tomorrow and in the years to come..\n                </p>\n          </div>\n          <div class=\"col-sm-6 \">\n            <h4>\n              <li class=\"fa fa-code\"></li> &nbsp;&nbsp;Simple &amp; Clean Code</h4>\n              <p class=\"para3\">\n                  We develop clear neat web application and website scripts with HTML5 / CSS3 / JS to give you best in website development to attract your clients.\n                  “A long descriptive name is better than a short enigmatic name. A long descriptive name is better than a long descriptive comment.”\n              </p>\n          </div>\n        </div> \n  </div>\n</div>\n\n\n<!-- Sections -->\n<section id=\"business\" class=\"portfolio sections\" style=\"padding-top: 100px !important;\">\n  <div class=\"container\">\n    <div class=\"row\">\n      <div class=\"portfolio-wrapper text-center\">\n        <div class=\"col-md-3 col-sm-6 col-xs-12\">\n          <div class=\"community-edition\">\n            <i class=\"fa fa-laptop\"></i>\n            <div class=\"separator\"></div>\n            <h4>WEB DESIGNING</h4>\n            <h5></h5>\n            <p style=\"font-size: 14px;\">\n              We have smart working web designer who develop world class web site as well as web applications and meet the requirement\n              of the customer as per their wishes.\n            </p>\n          </div>\n        </div>\n\n        <div class=\"col-md-3 col-sm-6 col-xs-12\">\n          <div class=\"community-edition\">\n            <i class=\"fa fa-desktop\"></i>\n            <div class=\"separator\"></div>\n            <h4>SOFTWARE DEVELOPMENT</h4>\n            <h5></h5>\n            <p style=\"font-size: 14px;\">\n              We have smart working developers who develop world class web site as well as web applications and meet the requirement of\n              the customer as per their wishes.\n            </p>\n          </div>\n        </div>\n\n        <div class=\"col-md-3 col-sm-6 col-xs-12\">\n          <div class=\"community-edition\">\n            <i class=\"fa fa-mobile\"></i>\n            <div class=\"separator\"></div>\n            <h4>MOBILE APPLICATION</h4>\n            <h5></h5>\n            <p style=\"font-size: 14px;\">\n              We have smart working mobile developer who develop world class iOS apps and Android apps and meet the requirement of the\n              customer as per their wishes.\n            </p>\n          </div>\n        </div>\n\n        <div class=\"col-md-3 col-sm-6 col-xs-12\">\n          <div class=\"community-edition\">\n            <i class=\"fa fa-phone\"></i>\n            <div class=\"separator\"></div>\n            <h4>GREAT SUPPORT</h4>\n            <h5></h5>\n            <p style=\"font-size: 14px;\">\n              We provide 24/7 Customer Support to our clients to feel free any time to get support with our developer team. \"Our Customer's\n              Perception is our Reality.\"\n            </p>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  </div>\n  <!-- /container -->\n</section>"

